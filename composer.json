{
    "name": "moe/laravel-task",
    "description": "MOE task management package for Laravel — assignment, priorities, dependencies, comments.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "task",
        "todo",
        "assignment",
        "workflow",
        "priority",
        "moe"
    ],
    "authors": [
        {
            "name": "MindOfEmanizer",
            "email": "mindofemanizer@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mindofemanizer/MOE-Laravel-Task/issues",
        "source": "https://github.com/mindofemanizer/MOE-Laravel-Task"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11 | ^12 | ^13",
        "illuminate/database": "^11 | ^12 | ^13"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^8 | ^9 | ^10",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Moe\\Task\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moe\\Task\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moe\\Task\\TaskServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
